    padding: 20px;
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
}

button {
    background: #4CAF50;
    color: white;
    border: none;
    padding: 15px 25px;
    font-size: 18px;
    border-radius: 50px;
    margin-top: 20px;
    cursor: pointer;
    box-shadow: 0 4px 8px rgba(0,0,0,0.2);
